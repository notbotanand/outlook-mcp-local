# Copy to .env for local development only.
# Never commit .env.

# Required: user-owned Microsoft application/client ID.
OUTLOOK_MCP_CLIENT_ID="00000000-0000-0000-0000-000000000000"

# Personal Microsoft accounts only.
# Future option: common, if work/school accounts are intentionally supported.
OUTLOOK_MCP_TENANT="consumers"

# Must match a localhost redirect URI registered on the user-owned Microsoft app.
OUTLOOK_MCP_REDIRECT_URI="http://127.0.0.1:53682/callback"

# Safe default: read-only mail + read-only calendar.
# Optional: calendar-write, which enables personal calendar block creation only.
OUTLOOK_MCP_MODE="read"

# Optional local development logging level.
# Must never log tokens, raw Graph responses, email bodies, or calendar bodies.
OUTLOOK_MCP_LOG_LEVEL="info"
